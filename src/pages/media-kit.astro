---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import monkcastLogo from '../assets/monkcast_logo.png';
import redmonkLogo from '../assets/redmonk_logo.png';
import stephen from '../assets/analysts/stephen.png';
import james from '../assets/analysts/james.png';
import rachel from '../assets/analysts/rachel.png';
import kate from '../assets/analysts/kate.png';

const hostImages = {
  stephen: stephen.src,
  james: james.src,
  rachel: rachel.src,
  kate: kate.src,
};
---

<Layout title="The MonkCast — Media Kit">
  <nav class="media-kit-nav" aria-label="Media kit sections">
    <div class="nav-links" id="nav-menu" data-section-nav>
      <a href="#positioning" aria-current="true"><span class="nav-index">01</span><span>About</span></a>
      <a href="#numbers"><span class="nav-index">02</span><span>The Numbers</span></a>
      <a href="#geography"><span class="nav-index">03</span><span>Geography</span></a>
      <a href="#hosts"><span class="nav-index">04</span><span>Show Hosts</span></a>
      <a href="#channels"><span class="nav-index">05</span><span>Channels</span></a>
      <a href="#opportunities"><span class="nav-index">06</span><span>Sponsorship</span></a>
    </div>
  </nav>

  <!-- ============== HERO ============== -->
  <section
    class="relative bg-gradient-to-br from-black via-secondary-900 to-secondary-800 text-white py-20 md:py-32 overflow-hidden"
    aria-labelledby="hero-heading"
  >
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-primary-500/20 via-primary-500/10 to-transparent" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_var(--tw-gradient-stops))] from-accent-500/20 via-transparent to-transparent" aria-hidden="true"></div>
    <div class="absolute left-1/4 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] aspect-[2/1] rounded-full bg-[radial-gradient(circle,_rgba(254,0,0,0.375)_0%,_rgba(254,0,0,0)_70%)] blur-md" aria-hidden="true"></div>

    <div class="container mx-auto px-4 relative z-10">
      <!-- Meta row -->
      <div class="flex flex-wrap items-baseline justify-between gap-4 mb-10 md:mb-16 font-mono text-xs uppercase tracking-widest text-gray-300">
        <span><span class="text-white font-bold">Media Kit</span> &nbsp;/&nbsp; The MonkCast</span>
        <span class="flex items-center gap-2">
          A <img src={redmonkLogo.src} alt="RedMonk" class="inline-block h-4 w-auto" /> Production
        </span>
        <span id="last-updated">Updated —</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-16 items-end">
        <div class="lg:col-span-2">
          <h1
            id="hero-heading"
            class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold leading-[0.9] tracking-tight mb-6"
          >
            The<br />
            <span style="color: #fe0000;">MonkCast</span>
          </h1>
          <p class="text-lg md:text-xl text-gray-200 max-w-2xl leading-relaxed">
            The podcast from <span style="color: #fe0000; font-weight: 600;">RedMonk</span>, the industry's premier developer-focused analyst firm. Candid conversations. Actionable insights. The technical audience your buyers actually listen to.
          </p>
        </div>

        <div class="flex justify-center lg:justify-end">
          <div class="relative">
            <div class="absolute inset-0 -m-8 rounded-full bg-[radial-gradient(circle,_rgba(0,0,0,0.7)_0%,_rgba(0,0,0,0)_70%)] blur-md"></div>
            <div class="relative w-40 h-40 md:w-56 md:h-56 rounded-full overflow-hidden shadow-2xl border-4 border-white/20 backdrop-blur-sm bg-white/5">
              <img src={monkcastLogo.src} alt="The MonkCast" class="w-full h-full object-contain" />
            </div>
          </div>
        </div>
      </div>

      <!-- Hero stat strip -->
      <div class="mt-16 md:mt-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-white/10 border border-white/10 rounded-xl overflow-hidden backdrop-blur-sm">
        <div class="bg-black/40 p-6 md:p-8">
          <div class="font-mono text-[10px] md:text-xs uppercase tracking-widest text-gray-400 mb-2">Monthly YouTube reach</div>
          <div class="text-4xl md:text-5xl font-bold" style="color: #fe0000;" id="h-monthlyViews">160K+</div>
        </div>
        <div class="bg-black/40 p-6 md:p-8">
          <div class="font-mono text-[10px] md:text-xs uppercase tracking-widest text-gray-400 mb-2">Avg sponsored views</div>
          <div class="text-4xl md:text-5xl font-bold" style="color: #fe0000;" id="h-sponsored">3K</div>
        </div>
        <div class="bg-black/40 p-6 md:p-8">
          <div class="font-mono text-[10px] md:text-xs uppercase tracking-widest text-gray-400 mb-2">LinkedIn community</div>
          <div class="text-4xl md:text-5xl font-bold" style="color: #fe0000;" id="h-linkedin">26K+</div>
        </div>
        <div class="bg-black/40 p-6 md:p-8">
          <div class="font-mono text-[10px] md:text-xs uppercase tracking-widest text-gray-400 mb-2">Top short views</div>
          <div class="text-4xl md:text-5xl font-bold" style="color: #fe0000;" id="h-topShort">32,904</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== POSITIONING / MANIFESTO ============== -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-gray-50 to-white" id="positioning" aria-labelledby="positioning-heading">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-4">
          <div class="section-kicker font-mono text-xs uppercase tracking-widest mb-4">§ 01 — About</div>
          <h2 id="positioning-heading" class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight text-secondary-900">
            Reach a high-intent audience that prizes <span style="color: #fe0000;">technical rigor.</span>
          </h2>
        </div>
        <div class="lg:col-span-8 space-y-5 text-base md:text-lg leading-relaxed text-secondary-800">
          <p class="manifesto-lead">
            As the industry's premier developer-focused analyst firm, RedMonk sits at the unique intersection of technology, business, and culture. Our podcast captures the "hallway track" of the industry: candid, off-script conversations between our analysts and the voices currently shaping the future of technology.
          </p>
          <p>
            We don't chase mass-market reach. <strong>We reach decision makers</strong>: platform engineers, CTOs, DevRel leaders, infrastructure architects, and the long tail of practitioners influential within their organizations. The MonkCast delivers actionable insights for leaders and practitioners alike.
          </p>
          <p>
            Our distribution is intentionally multi-channel across multiple platforms. <strong>YouTube and LinkedIn</strong> are our primary video channels. <strong>Spotify and Apple Podcasts</strong> serve direct podcast subscribers. <strong>X and Bluesky</strong> amplify episodes from both the official RedMonk and personal analyst accounts. The result: a single sponsored episode propagates across an interconnected network of high-intent technical readers, viewers, and listeners.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== STATS ============== -->
  <section
    class="relative py-20 md:py-28 bg-gradient-to-br from-black via-secondary-900 to-secondary-900 text-white overflow-hidden"
    id="numbers"
    aria-labelledby="numbers-heading"
  >
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-primary-500/15 via-transparent to-transparent" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_var(--tw-gradient-stops))] from-primary-500/10 via-transparent to-transparent" aria-hidden="true"></div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 md:mb-16">
        <div>
          <div class="section-kicker on-dark font-mono text-xs uppercase tracking-widest mb-3">§ 02 — The Numbers</div>
          <h2 id="numbers-heading" class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight max-w-xl">
            By the numbers, <span style="color: #fe0000; font-style: italic;">not</span> the noise.
          </h2>
        </div>
        <p class="font-mono text-xs uppercase tracking-wider text-gray-400 max-w-xs leading-relaxed">
          All figures reflect the most recent reporting window. Sourced from YouTube Studio, LinkedIn, and our podcast hosting platform.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
        <!-- Big stat -->
        <div class="md:col-span-8 stat-card hover-lift">
          <div class="stat-label">Monthly YouTube Reach</div>
          <div class="stat-num" id="s-monthlyViews">160K+</div>
          <p class="stat-detail">Monthly views across long-form episodes and shorts. The MonkCast's primary distribution surface for technical audiences.</p>
          <div class="absolute top-5 right-5 font-mono text-[10px] tracking-widest" style="color: #fe0000;">▲ TRENDING</div>
        </div>

        <!-- Small impressions -->
        <div class="md:col-span-4 stat-card hover-lift">
          <div class="stat-label">Monthly Impressions</div>
          <div class="stat-num" id="s-impressions">41.8K</div>
          <p class="stat-detail">Monthly YouTube thumbnail impressions — how often MonkCast content surfaces to potential viewers.</p>
        </div>

        <!-- Mid LinkedIn -->
        <div class="md:col-span-6 stat-card hover-lift">
          <div class="stat-label">LinkedIn Amplification</div>
          <div class="stat-num" id="s-linkedin">20K+</div>
          <p class="stat-detail">Combined followers across the RedMonk company page and analyst accounts, creating sustained visibility with our community.</p>
        </div>

        <!-- Mid sponsored -->
        <div class="md:col-span-6 stat-card hover-lift">
          <div class="stat-label">Avg Episode Views</div>
          <div class="stat-num" id="s-sponsored">3K</div>
          <p class="stat-detail">Average views per video over the last 60 days. High-quality views from a high-intent technical audience.</p>
        </div>

        <!-- Quad cell strip -->
        <div class="md:col-span-12 grid grid-cols-2 md:grid-cols-4 gap-px bg-white/10 border border-white/10 rounded-xl overflow-hidden">
          <div class="bg-black/30 p-6">
            <div class="stat-label">Long-Form Views / mo</div>
            <div class="stat-num-mid" id="s-lfviews">20K</div>
          </div>
          <div class="bg-black/30 p-6">
            <div class="stat-label">Shorts Views / mo</div>
            <div class="stat-num-mid" id="s-svviews">140K</div>
          </div>
          <div class="bg-black/30 p-6">
            <div class="stat-label">YouTube Subscribers</div>
            <div class="stat-num-mid" id="s-subs">8,161</div>
          </div>
          <div class="bg-black/30 p-6">
            <div class="stat-label">Analyst Hosts</div>
            <div class="stat-num-mid">4</div>
          </div>
        </div>
      </div>

      <!-- Spotlight foot stats -->
      <div class="mt-14 md:mt-20 grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <a href="https://youtube.com/shorts/dAkit6m28Xs" target="_blank" rel="noopener" class="spotlight-card hover-lift" aria-label="Watch the most-liked short, Bare Metal Observability, on YouTube. Opens in a new tab.">
          <div class="spotlight-num">1.2K</div>
          <div class="spotlight-label">Most-liked short<br /><span>Bare Metal Observability</span></div>
        </a>
        <a href="https://youtube.com/shorts/AcRGXjOksHo" target="_blank" rel="noopener" class="spotlight-card hover-lift" aria-label="Watch the most-viewed short, Eclipse SDV, on YouTube. Opens in a new tab.">
          <div class="spotlight-num">33K</div>
          <div class="spotlight-label">Most-viewed short<br /><span>Eclipse SDV</span></div>
        </a>
        <a href="https://www.youtube.com/watch?v=k6mBLpsbiq8" target="_blank" rel="noopener" class="spotlight-card hover-lift" aria-label="Watch the most-viewed long-form episode, Opinionated Infrastructure, on YouTube. Opens in a new tab.">
          <div class="spotlight-num">12.6K</div>
          <div class="spotlight-label">Most-viewed long-form<br /><span>Opinionated Infrastructure</span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- ============== GEOGRAPHY ============== -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-white to-gray-50" id="geography" aria-labelledby="geo-heading">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-12 mb-10 md:mb-14 items-end">
        <div>
          <div class="section-kicker font-mono text-xs uppercase tracking-widest mb-3">§ 03 — Geography</div>
          <h2 id="geo-heading" class="text-4xl md:text-5xl font-bold leading-tight text-secondary-900">
            Where the audience <span style="color: #fe0000;">lives.</span>
          </h2>
        </div>
        <p class="md:col-span-2 text-base md:text-lg leading-relaxed text-secondary-700 max-w-3xl">
          The MonkCast reaches a globally distributed audience of engineers, developers, and technology leaders. Explore the map below to see where the MonkCast community lives, works, and listens.
        </p>
      </div>

      <div class="geo-map-frame">
        <div class="geo-map-canvas">
          <svg class="geo-map" viewBox="0 0 1000 500" preserveAspectRatio="xMidYMid meet" role="img" aria-labelledby="geo-map-title geo-map-desc">
            <title id="geo-map-title">World map of MonkCast audience distribution</title>
            <desc id="geo-map-desc">A world map plotting MonkCast's top audience countries for YouTube and Podcast. Each country has concentric circles — red for YouTube views, dark for podcast streams — sized in proportion to share of total audience.</desc>
            <g class="geo-graticule" aria-hidden="true">
              <line x1="0" y1="250" x2="1000" y2="250" />
              <line x1="500" y1="0" x2="500" y2="500" />
            </g>
            <g class="geo-markers" id="geo-markers"></g>
            <g class="geo-labels" id="geo-labels"></g>
          </svg>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-6 md:gap-12 pt-5 border-t border-gray-200" role="group" aria-label="Map key">
        <div class="section-kicker font-mono text-xs uppercase tracking-widest">Key</div>
        <div class="flex items-center gap-3">
          <span class="legend-swatch is-yt" aria-hidden="true"></span>
          <div class="font-mono text-xs leading-tight">
            <div class="text-secondary-900">YouTube audience</div>
            <div class="text-secondary-500 text-[10px] mt-1 uppercase">Views by country · last 12 mo</div>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="legend-swatch is-pod" aria-hidden="true"></span>
          <div class="font-mono text-xs leading-tight">
            <div class="text-secondary-900">Spotify + Apple Podcasts</div>
            <div class="text-secondary-500 text-[10px] mt-1 uppercase">Streams by country · last 12 mo</div>
          </div>
        </div>
      </div>
      <div class="sr-only" id="geo-text-summary"></div>
    </div>
  </section>

  <!-- ============== HOSTS ============== -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-gray-50 to-white" id="hosts" aria-labelledby="hosts-mediakit-heading">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-12 mb-12 md:mb-16 items-end">
        <div>
          <div class="section-kicker font-mono text-xs uppercase tracking-widest mb-3">§ 04 — Show Hosts</div>
          <h2 id="hosts-mediakit-heading" class="text-4xl md:text-5xl font-bold leading-tight text-secondary-900">
            Four <span style="color: #fe0000;">analysts.</span> Vibrant conversation.
          </h2>
        </div>
        <p class="md:col-span-2 text-base md:text-lg leading-relaxed text-secondary-700 max-w-3xl">
          RedMonk analysts have been talking to developers and the companies that serve them since 2002. The MonkCast is hosted by the same people writing the research, briefing executives, and publicly engaging in visible, high-trust conversations.
        </p>
      </div>

      <!-- Aggregate row -->
      <div class="card bg-white p-8 md:p-10 mb-10 flex flex-col md:flex-row items-center gap-6 md:gap-12">
        <div class="text-6xl md:text-8xl font-bold leading-none" style="color: #fe0000;" id="hosts-aggregate-num">—</div>
        <p class="font-mono text-xs md:text-sm uppercase tracking-widest text-secondary-700 leading-relaxed max-w-sm text-center md:text-left">
          combined social followers across all four analyst hosts
        </p>
      </div>

      <!-- Platform breakdown -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mb-12 md:mb-16">
        <div class="card bg-white p-6 hover-lift">
          <div class="font-mono text-xs uppercase tracking-widest text-secondary-500 mb-3">X (Twitter)</div>
          <div class="text-3xl md:text-4xl font-bold text-secondary-900 mb-2" id="hosts-agg-x">—</div>
          <p class="text-sm text-secondary-600">Combined followers across all four analyst accounts.</p>
        </div>
        <div class="card bg-white p-6 hover-lift">
          <div class="font-mono text-xs uppercase tracking-widest text-secondary-500 mb-3">Bluesky</div>
          <div class="text-3xl md:text-4xl font-bold text-secondary-900 mb-2" id="hosts-agg-bluesky">—</div>
          <p class="text-sm text-secondary-600">Combined followers across all four analyst accounts.</p>
        </div>
        <div class="card bg-white p-6 hover-lift">
          <div class="font-mono text-xs uppercase tracking-widest text-secondary-500 mb-3">LinkedIn</div>
          <div class="text-3xl md:text-4xl font-bold text-secondary-900 mb-2" id="hosts-agg-linkedin">—</div>
          <p class="text-sm text-secondary-600">Combined followers across all four analyst accounts.</p>
        </div>
      </div>

      <!-- Host cards -->
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-6" id="hosts-grid" role="list"></ul>
    </div>
  </section>

  <!-- ============== CHANNELS ============== -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-white to-gray-50" id="channels" aria-labelledby="channels-heading">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-12 mb-12 md:mb-16 items-end">
        <div>
          <div class="section-kicker font-mono text-xs uppercase tracking-widest mb-3">§ 05 — Channels</div>
          <h2 id="channels-heading" class="text-4xl md:text-5xl font-bold leading-tight text-secondary-900">
            Every <span style="color: #fe0000;">surface</span> your audience uses.
          </h2>
        </div>
        <p class="md:col-span-2 text-base md:text-lg leading-relaxed text-secondary-700 max-w-3xl">
          MonkCast episodes don't live in one place. You can find our content on YouTube, Apple Podcasts, Spotify, and LinkedIn, while cross-promotion across other social platforms extends each conversation.
        </p>
      </div>

      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" id="channels-grid" role="list"></ul>
    </div>
  </section>

  <!-- ============== OPPORTUNITIES ============== -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-gray-50 to-white" id="opportunities" aria-labelledby="opps-heading">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-12 mb-12 md:mb-16 items-end">
        <div>
          <div class="section-kicker font-mono text-xs uppercase tracking-widest mb-3">§ 06 — Sponsorship</div>
          <h2 id="opps-heading" class="text-4xl md:text-5xl font-bold leading-tight text-secondary-900">
            How we <span style="color: #fe0000;">partner.</span>
          </h2>
        </div>
        <p class="md:col-span-2 text-base md:text-lg leading-relaxed text-secondary-700 max-w-3xl">
          Three core formats, designed to fit different campaign goals.
          All MonkCasts are hosted by a RedMonk analyst and include detailed show notes with links and transcripts on RedMonk's website. Promotion via YouTube shorts, LinkedIn cross-posts, and social media.
        </p>
      </div>

      <ul class="grid grid-cols-1 md:grid-cols-3 gap-6" id="opps-grid" role="list"></ul>
    </div>
  </section>

  <!-- ============== CTA ============== -->
  <section
    class="relative py-24 md:py-32 bg-gradient-to-br from-black via-secondary-900 to-secondary-900 text-white overflow-hidden"
    id="contact"
    aria-labelledby="contact-heading"
  >
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-primary-500/20 via-primary-500/5 to-transparent" aria-hidden="true"></div>
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[70%] aspect-square rounded-full bg-[radial-gradient(circle,_rgba(254,0,0,0.25)_0%,_rgba(254,0,0,0)_70%)] blur-2xl" aria-hidden="true"></div>

    <div class="container mx-auto px-4 relative z-10 text-center md:text-left">
      <div class="section-kicker on-dark font-mono text-xs uppercase tracking-widest mb-4">§ 07 — Get in touch</div>
      <h2 id="contact-heading" class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight mb-6 max-w-3xl mx-auto md:mx-0">
        Let's start a <span style="color: #fe0000;">conversation.</span>
      </h2>
      <p class="text-lg md:text-xl text-gray-200 max-w-2xl mx-auto md:mx-0 mb-10 leading-relaxed">
        Tell us what you're working on. We'll come back with a proposal, a rate card, and an editorial concept that fits your audience and ours.
      </p>

      <address class="not-italic flex flex-wrap gap-4 items-center justify-center md:justify-start">
        <a class="btn btn-primary px-7 py-3 rounded-md text-sm md:text-base" id="cta-email" href="#">
          <span>sales@redmonk.com</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6" /></svg>
        </a>
        <a class="cta-ghost px-7 py-3 rounded-md text-sm md:text-base" id="cta-site" href="https://redmonk.com" target="_blank" rel="noopener">
          Visit redmonk.com
        </a>
      </address>

    </div>
  </section>


  <!-- Data island -->
  <script id="kit-data" type="application/json" is:inline set:html={JSON.stringify({
    lastUpdated: "May 2026",
    headline: { totalMonthlyViews: "160K+", linkedInTotal: "26K+", sponsoredAvg: "3K" },
    youtube: { subscribers: 8161, monthlyViewsLongForm: "20K", monthlyImpressions: "41.8K", monthlyViewsShorts: "140K" },
    geography: {
      windowLabel: "Last 12 months",
      youtube: [
        { country: "India", percentage: 84.9 },
        { country: "United States", percentage: 4.4 },
        { country: "United Kingdom", percentage: 1.1 },
        { country: "Australia", percentage: 0.4 },
        { country: "Germany", percentage: 0.3 },
        { country: "Canada", percentage: 0.2 },
        { country: "Netherlands", percentage: 0.1 }
      ],
      podcast: [
        { country: "United States", percentage: 55 },
        { country: "Vietnam", percentage: 6 },
        { country: "United Kingdom", percentage: 4 },
        { country: "Singapore", percentage: 4 },
        { country: "Germany", percentage: 3 },
        { country: "Australia", percentage: 3 },
        { country: "Japan", percentage: 2 },
        { country: "Canada", percentage: 2 },
        { country: "India", percentage: 1 },
        { country: "Netherlands", percentage: 1 }
      ]
    },
    topShorts: [{ title: "Eclipse Software Defined Vehicle", views: 32904 }],
    hosts: [
      {
