    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.15;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .nav-links a::before {
    content: "";
    position: absolute;
    inset: 8px auto 8px 0;
