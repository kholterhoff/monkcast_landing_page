    .nav-links a,
    .stat-card,
    .spotlight-card,
    .cta-ghost,
    :global(.host-card),
    :global(.host-social a),
    :global(.channel-card),
    :global(.channel-link),
    :global(.opp-card),
    :global(.geo-marker-ring),
    :global(.geo-marker-dot) {
      transition: none;
    }
    .spotlight-card:hover,
    .cta-ghost:hover,
    :global(.host-card:hover),
    :global(.channel-card:hover),
    :global(.opp-card:hover) {
      transform: none;
    }
  }
</style>

<script>
  const dataEl = document.getElementById('kit-data');
  const DATA = JSON.parse(dataEl ? dataEl.textContent || '{}' : '{}');
  const sectionNavLinks = Array.from(document.querySelectorAll('[data-section-nav] a')) as HTMLAnchorElement[];
  const sectionIds = sectionNavLinks.map((link) => link.hash.slice(1)).filter(Boolean);
  const navSections = sectionIds
    .map((id) => document.getElementById(id))
    .filter(Boolean) as HTMLElement[];

  function setActiveSection(id: string) {
    sectionNavLinks.forEach((link) => {
      const isActive = link.hash === `#${id}`;
      if (isActive) {
        link.setAttribute('aria-current', 'true');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  if (sectionNavLinks.length && navSections.length) {
    if ('IntersectionObserver' in window) {
      const visibleSections = new Map<string, number>();
      const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            visibleSections.set(entry.target.id, entry.intersectionRatio);
          } else {
            visibleSections.delete(entry.target.id);
          }
        });

        const active = Array.from(visibleSections.entries())
          .sort((a, b) => b[1] - a[1])[0]?.[0];
        if (active) setActiveSection(active);
      }, {
        rootMargin: '-28% 0px -48% 0px',
        threshold: [0.05, 0.2, 0.45, 0.7],
      });

      navSections.forEach((section) => sectionObserver.observe(section));
    } else {
      const updateActiveFromScroll = () => {
        const active = navSections.reduce((current, section) => {
          return section.getBoundingClientRect().top <= window.innerHeight * 0.35 ? section : current;
        }, navSections[0]);
        setActiveSection(active.id);
      };
      updateActiveFromScroll();
      window.addEventListener('scroll', updateActiveFromScroll, { passive: true });
    }
  }

  // Updated badge
  const updatedEl = document.getElementById('last-updated');
  if (updatedEl) updatedEl.textContent = `Updated · ${DATA.lastUpdated}`;

  const fmt = (n: any) => typeof n === 'number' ? n.toLocaleString() : n;

  function setStat(id: string, value: any) {
    const el = document.getElementById(id);
    if (!el || value == null) return;
    el.textContent = typeof value === 'number' ? fmt(value) : String(value);
  }
  setStat('s-monthlyViews', DATA.headline.totalMonthlyViews);
  setStat('s-linkedin', DATA.headline.linkedInTotal);
  setStat('s-sponsored', DATA.headline.sponsoredAvg);
  setStat('s-impressions', DATA.youtube.monthlyImpressions);
  setStat('s-lfviews', DATA.youtube.monthlyViewsLongForm);
  setStat('s-svviews', DATA.youtube.monthlyViewsShorts);
  setStat('s-subs', DATA.youtube.subscribers);
  setStat('h-monthlyViews', DATA.headline.totalMonthlyViews);
  setStat('h-linkedin', DATA.headline.linkedInTotal);
  setStat('h-sponsored', DATA.headline.sponsoredAvg);
  setStat('h-topShort', DATA.topShorts?.[0]?.views ?? null);

  // Geography map
  const COUNTRY_GEO: Record<string, any> = {
    'United States':   { x: 228, y: 142, labelX: 198, labelY: 188, anchor: 'end',   leader: 'M 228,142 L 218,165 L 198,182' },
    'Canada':          { x: 206, y:  84, labelX: 168, labelY:  62, anchor: 'end',   leader: 'M 206,84 L 188,72 L 168,58' },
    'United Kingdom':  { x: 492, y: 100, labelX: 432, labelY:  62, anchor: 'end',   leader: 'M 492,100 L 470,80 L 432,58' },
    'Germany':         { x: 528, y: 108, labelX: 586, labelY:  62, anchor: 'start', leader: 'M 528,108 L 560,82 L 586,58' },
    'Netherlands':     { x: 514, y: 106, labelX: 612, labelY: 130, anchor: 'start', leader: 'M 514,106 L 565,120 L 612,126' },
    'India':           { x: 717, y: 189, labelX: 715, labelY: 348, anchor: 'middle', leader: 'M 717,219 L 717,344' },
    'Vietnam':         { x: 800, y: 206, labelX: 868, labelY: 174, anchor: 'start', leader: 'M 800,206 L 838,188 L 868,170' },
    'Singapore':       { x: 789, y: 247, labelX: 858, labelY: 268, anchor: 'start', leader: 'M 789,247 L 820,258 L 858,264' },
    'Japan':           { x: 883, y: 150, labelX: 952, labelY: 122, anchor: 'middle', leader: 'M 883,150 L 920,135 L 952,118' },
    'Australia':       { x: 872, y: 319, labelX: 868, labelY: 450, anchor: 'middle', leader: 'M 872,355 L 870,446' }
  };

  function geoMarkerRadius(pct: number) {
    if (!pct || pct <= 0) return 0;
    return Math.max(5, Math.sqrt(pct) * 3.4);
  }

  function renderGeoMap() {
    const markers = document.getElementById('geo-markers');
    const labels = document.getElementById('geo-labels');
    if (!markers || !labels || !DATA.geography) return;

    const ytMap = new Map((DATA.geography.youtube || []).map((d: any) => [d.country, d.percentage]));
    const pdMap = new Map((DATA.geography.podcast || []).map((d: any) => [d.country, d.percentage]));
    const allCountries = new Set([...ytMap.keys(), ...pdMap.keys()]);

    const markerSvg: string[] = [];
    const labelSvg: string[] = [];

    allCountries.forEach((country: any) => {
      const geo = COUNTRY_GEO[country];
      if (!geo) return;
      const yt = (ytMap.get(country) as number) || 0;
      const pd = (pdMap.get(country) as number) || 0;
      const rYt = geoMarkerRadius(yt);
      const rPd = geoMarkerRadius(pd);

      const ytRing = `<circle class="geo-marker-ring geo-marker-yt-ring" cx="${geo.x}" cy="${geo.y}" r="${rYt}" fill="#fe0000" stroke="#fe0000" />`;
      const pdRing = `<circle class="geo-marker-ring geo-marker-pod-ring" cx="${geo.x}" cy="${geo.y}" r="${rPd}" fill="#253444" stroke="#253444" />`;
      const ytDot = rYt > 0 ? `<circle class="geo-marker-dot geo-marker-yt-dot" cx="${geo.x}" cy="${geo.y}" r="${Math.min(3.5, rYt * 0.45)}" fill="#fe0000" />` : '';
      const pdDot = rPd > 0 ? `<circle class="geo-marker-dot geo-marker-pod-dot" cx="${geo.x}" cy="${geo.y}" r="${Math.min(3.5, rPd * 0.45)}" fill="#253444" />` : '';

      const ordered = rYt >= rPd ? [ytRing, pdRing, ytDot, pdDot] : [pdRing, ytRing, pdDot, ytDot];

      markerSvg.push(`<g class="geo-marker-group" aria-hidden="true">${ordered.join('')}</g>`);

      const ytLabel = yt ? `YT ${yt}%` : '';
      const pdLabel = pd ? `Pod ${pd}%` : '';
      const sep = ytLabel && pdLabel ? ' · ' : '';

      labelSvg.push(`
        <g class="geo-label-group" aria-hidden="true">
          <path class="geo-leader" d="${geo.leader}" />
          <text class="geo-label-country" x="${geo.labelX}" y="${geo.labelY}" text-anchor="${geo.anchor}">${country}</text>
          <text class="geo-label-pct" x="${geo.labelX}" y="${geo.labelY + 13}" text-anchor="${geo.anchor}">
            ${ytLabel ? `<tspan fill="#c90000">${ytLabel}</tspan>` : ''}${sep ? `<tspan fill="#6b7280">${sep}</tspan>` : ''}${pdLabel ? `<tspan fill="#253444">${pdLabel}</tspan>` : ''}
          </text>
        </g>
      `);
    });

    markers.innerHTML = markerSvg.join('');
    labels.innerHTML = labelSvg.join('');

    const summary = document.getElementById('geo-text-summary');
    if (summary) {
      const rows = Array.from(allCountries).map((country: any) => {
        const yt = (ytMap.get(country) as number) || 0;
        const pd = (pdMap.get(country) as number) || 0;
        const ytText = yt ? `${yt}%` : 'not listed among top YouTube countries';
        const pdText = pd ? `${pd}%` : 'not listed among top podcast countries';
        return `${country}: YouTube ${ytText}, podcast ${pdText}.`;
      });
      summary.textContent = `Audience by country. ${rows.join(' ')}`;
    }
  }
  if (DATA.geography) renderGeoMap();

  // Hosts
  function parseFollowerCount(s: string) {
    return parseFloat(String(s).replace(/[K+\s]/gi, '')) * 1000;
  }
  function renderHosts() {
    const m = document.getElementById('hosts-grid');
    const agg = document.getElementById('hosts-aggregate-num');
    if (!Array.isArray(DATA.hosts)) return;

    if (agg) {
      const total = DATA.hosts.reduce((sum: number, h: any) => sum + parseFollowerCount(h.reachTotal), 0);
      agg.textContent = Math.round(total / 1000) + 'K+';
    }

    const platformTotals: Record<string, number> = {};
    DATA.hosts.forEach((h: any) => {
      (h.socials || []).forEach((s: any) => {
        const key = s.platform.toLowerCase();
        platformTotals[key] = (platformTotals[key] || 0) + parseFollowerCount(s.followers);
      });
    });
    const platformEls: Record<string, string> = { x: 'hosts-agg-x', bluesky: 'hosts-agg-bluesky', linkedin: 'hosts-agg-linkedin' };
    Object.entries(platformEls).forEach(([key, id]) => {
      const el = document.getElementById(id);
      if (el && platformTotals[key]) el.textContent = Math.round(platformTotals[key] / 1000) + 'K+';
    });

    if (!m) return;
    m.innerHTML = DATA.hosts.map((h: any) => {
      const img = DATA.hostImages[h.imageKey] || '';
      const socials = Array.isArray(h.socials) ? h.socials : [];
      const links = socials.map((s: any) => `
        <a href="${s.url}" target="_blank" rel="noopener" aria-label="${h.name} on ${s.platform}: ${s.handle}. Opens in a new tab.">
          <span class="host-social-platform">${s.platform}</span>
          <span class="host-social-handle">${s.handle}</span>
        </a>
      `).join('');
      return `
        <li class="host-card">
          <div class="host-portrait" role="img" aria-label="Photo of ${h.name}" style="background-image: url('${img}')"></div>
          <div>
            <h3 class="host-name">${h.name}</h3>
            <div class="host-role">${h.role}</div>
            <p class="host-bio">${h.bio}</p>
            <div class="host-social" role="group" aria-label="${h.name} social profiles">${links}</div>
          </div>
        </li>
      `;
    }).join('');
  }
  renderHosts();

  // Channels
  const ICONS: Record<string, string> = {
    youtube: '<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg>',
    linkedin: '<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14a5 5 0 0 0-5 5v14a5 5 0 0 0 5 5h14a5 5 0 0 0 5-5v-14a5 5 0 0 0-5-5zm-11 19h-3v-11h3v11zm-1.5-12.3a1.7 1.7 0 1 1 0-3.4 1.7 1.7 0 0 1 0 3.4zm13.5 12.3h-3v-5.6c0-1.4-.5-2.4-1.8-2.4-1 0-1.6.7-1.9 1.4-.1.2-.1.6-.1.9v5.7h-3s.1-9.3 0-10.2h3v1.4c.4-.6 1.1-1.6 2.8-1.6 2 0 3.5 1.3 3.5 4.2v6.2z"/></svg>',
    spotify: '<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24zm5.5 17.3a.75.75 0 0 1-1 .25c-2.8-1.7-6.3-2.1-10.4-1.1a.75.75 0 0 1-.3-1.5c4.5-1 8.4-.6 11.6 1.3.3.2.4.6.1 1zm1.5-3a.94.94 0 0 1-1.3.3c-3.2-2-8.1-2.6-11.9-1.4a.94.94 0 0 1-.5-1.8c4.3-1.3 9.7-.7 13.3 1.6.4.2.5.8.4 1.3zm.1-3.1c-3.9-2.3-10.3-2.5-14-1.4a1.13 1.13 0 0 1-.6-2.1c4.3-1.3 11.4-1.1 15.8 1.5a1.13 1.13 0 0 1-1.2 1.9z"/></svg>',
    apple: '<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18.7 17.1c-.4.9-.6 1.3-1.1 2.1-.7 1.1-1.7 2.5-3 2.5-1.1 0-1.4-.7-3-.7-1.5 0-1.8.7-3 .7-1.2 0-2.2-1.3-2.9-2.4-1.9-3.1-2.1-6.8-1-8.8.9-1.4 2.2-2.3 3.5-2.3 1.3 0 2.1.7 3.2.7 1 0 1.7-.7 3.2-.7 1.2 0 2.4.6 3.3 1.7-2.9 1.6-2.4 5.7.8 7.2zM13 5.2c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.5.6-1 1.6-.8 2.6 1 .1 2-.5 2.4-1.2z"/></svg>'
  };

  function renderChannels() {
    const m = document.getElementById('channels-grid');
    if (!m || !Array.isArray(DATA.channels)) return;
    m.innerHTML = DATA.channels.map((c: any) => `
      <li class="channel-card">
        <div class="channel-icon" aria-hidden="true">${ICONS[c.iconKey] || ''}</div>
        <h3>${c.name}</h3>
        <div class="channel-stat">${c.stat}</div>
        <div class="channel-desc">${c.desc}</div>
        <a class="channel-link" href="${c.url}" target="_blank" rel="noopener" aria-label="${c.linkLabel}: ${c.name}. Opens in a new tab.">${c.linkLabel} →</a>
      </li>
    `).join('');
  }
  renderChannels();

  // Opportunities
  function renderOpps() {
    const m = document.getElementById('opps-grid');
    if (!m || !Array.isArray(DATA.opportunities)) return;
    m.innerHTML = DATA.opportunities.map((o: any, i: number) => {
      const bullets = (o.bullets || []).map((b: string) => `<li>${b}</li>`).join('');
      return `
        <li class="opp-card">
          <div class="opp-num">№ ${String(i + 1).padStart(2, '0')} · ${o.kind}</div>
          <h3>${o.title}</h3>
          <p>${o.summary}</p>
          ${bullets ? `<ul class="opp-bullets">${bullets}</ul>` : ''}
        </li>
      `;
    }).join('');
  }
  renderOpps();

  // Contact
  const emailBtn = document.getElementById('cta-email') as HTMLAnchorElement | null;
  if (emailBtn && DATA.contact) {
    emailBtn.href = `mailto:${DATA.contact.email}`;
    emailBtn.setAttribute('aria-label', `Email us at ${DATA.contact.email}`);
  }
  const siteBtn = document.getElementById('cta-site') as HTMLAnchorElement | null;
  if (siteBtn && DATA.contact) {
    siteBtn.href = DATA.contact.siteUrl;
    siteBtn.textContent = DATA.contact.siteLabel;
    siteBtn.setAttribute('aria-label', `${DATA.contact.siteLabel}. Opens in a new tab.`);
  }
</script>
