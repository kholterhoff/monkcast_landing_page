    backdrop-filter: blur(18px);
    pointer-events: auto;
  }
  .nav-links a {
    position: relative;
    display: grid;
    grid-template-columns: 28px 1fr;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    color: rgba(255, 255, 255, 0.68);
